# Docked profile — two modes, selected by the `mode` static_template_value:
#   external_only : laptop panel off, all workspaces on the external
#   dual          : external + laptop, ws 1-4 external (1 default), ws 5-6 laptop (5 default)
# Toggle with `hdm-docked-toggle` or Omarchy menu: Trigger > Toggle > Docked Display.
# TUI-editable monitor block (markers) lives in the external_only mode.

{{ if eq .mode "external_only" }}
workspace=1,monitor:desc:AOC 24G2W1G4 ATNM4XA001012,persistent:true,default:true
workspace=2,monitor:desc:AOC 24G2W1G4 ATNM4XA001012,persistent:true
workspace=3,monitor:desc:AOC 24G2W1G4 ATNM4XA001012,persistent:true
workspace=4,monitor:desc:AOC 24G2W1G4 ATNM4XA001012,persistent:true
workspace=5,monitor:desc:AOC 24G2W1G4 ATNM4XA001012,persistent:true
workspace=6,monitor:desc:AOC 24G2W1G4 ATNM4XA001012,persistent:true
# <<<<< TUI AUTO START
monitor=desc:AU Optronics 0x21ED,disable
monitor=desc:AOC 24G2W1G4 ATNM4XA001012,1920x1080@144.00000,6x0,1.00000000,transform,0,vrr,0
# <<<<< TUI AUTO END
{{ end }}

{{ if eq .mode "dual" }}
workspace=1,monitor:desc:AOC 24G2W1G4 ATNM4XA001012,persistent:true,default:true
workspace=2,monitor:desc:AOC 24G2W1G4 ATNM4XA001012,persistent:true
workspace=3,monitor:desc:AOC 24G2W1G4 ATNM4XA001012,persistent:true
workspace=4,monitor:desc:AOC 24G2W1G4 ATNM4XA001012,persistent:true
workspace=5,monitor:desc:AU Optronics 0x21ED,persistent:true,default:true
workspace=6,monitor:desc:AU Optronics 0x21ED,persistent:true
monitor=desc:AOC 24G2W1G4 ATNM4XA001012,1920x1080@144.00000,0x0,1.00000000,transform,0,vrr,0
monitor=desc:AU Optronics 0x21ED,1920x1080@60.03000,auto-right,1.25000000,transform,0,vrr,0
{{ end }}
